# ─── .env.example ─────────────────────────────────────────────────────────
#
# Template for the project's environment variables. Copy to `.env` and fill
# in the secret values:
# `.env` is gitignored (line 151 of .gitignore) — do not commit it.
#
# This project does NOT auto-load .env. To make the variables visible to
# Python/pip processes, source the file in your shell before running:
#
#   bash/zsh:   set -a && source .env && set +a
#   fish:       export (cat .env | grep -v '^#' | grep '=' | string trim)
#               # or install the `bass` plugin: bass source .env
#
# Then `echo $TABPFN_TOKEN` should print the value, and any tabpfn call
# will pick it up automatically.
#


# ─── TabPFN authentication ───────────────────────────────────────────────
# Used by:    tabpfn>=7.x (TabPFNClassifier model checkpoint downloads)
# Read from:  TABPFN_TOKEN environment variable (tabpfn/browser_auth.py:79)
# Required:   when downloading TabPFN-v2.5 / v2.6 checkpoints in non-
#             interactive environments (CI, SSH/cluster runs, headless
#             scripts). Interactive terminals can use the browser flow
#             instead — set this only if you cannot open a browser.
# Get it:     https://ux.priorlabs.ai/account  (login → API Keys)
# Tied to:    a per-account license acceptance at https://ux.priorlabs.ai
#             — accept each model version's license once on the Licenses
#             tab (e.g. tabpfn_2_5, tabpfn_2_6) before the token unlocks
#             the corresponding checkpoint downloads.
TABPFN_TOKEN=


# ─── HuggingFace Hub fallback (optional) ─────────────────────────────────
# Used by:    huggingface_hub (transitive dep of tabpfn for model fetches)
# Read from:  HF_TOKEN environment variable
# Required:   only as a fallback if TABPFN_TOKEN is unset and you want to
#             use a personal HF token to fetch the gated Prior-Labs/* repos
#             directly. TABPFN_TOKEN above handles the same authorisation
#             through PriorLabs' UX layer.
# Get it:     https://huggingface.co/settings/tokens  (create a "Read" token)
HF_TOKEN=


# ─── Notes ────────────────────────────────────────────────────────────────
# - This project's runtime code does not read any .env variables itself;
#   the variables exist purely so external libraries (tabpfn, huggingface_hub)
#   pick them up from the process environment.
