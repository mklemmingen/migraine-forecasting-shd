@article{petrusic2024evaluation,
  author  = {Petru{\v s}i{\'c}, Igor and Savi{\'c}, Andrej and Mitrovi{\'c}, Katarina and Ba{\v c}anin, Neboj{\v s}a and Sebastianelli, Gabriele and Secci, Daniele and Coppola, Gianluca},
  title   = {Machine learning classification meets migraine: recommendations for study evaluation},
  journal = {The Journal of Headache and Pain},
  volume  = {25},
  number  = {215},
  pages   = {215},
  year    = {2024},
  month   = dec,
  doi     = {10.1186/s10194-024-01924-x},
  pmid    = {39639193},
  pmcid   = {PMC11622592},
  note    = {Open access (CC BY-NC-ND 4.0; note the no-derivatives clause, distinct from the journal's default CC BY 4.0) via BMC. Methodology article from a JHP editorial-board team (IP serves as Junior and Guest Editor of JHP; GC serves as Associate Editor for JHP and Cephalalgia per the Competing Interests block). Proposes six evaluation criteria for ML-classification studies in migraine: (1) group homogenization by clinical phenotype, attack frequency, comorbidity, therapy, and demographics; (2) defining adequate sample size; (3) quality control of collected and preprocessed data; (4) transparent training, testing, and performance evaluation including data splitting, overfitting control, and feature selection; (5) interpretability of results with clinical relevance; and (6) open data and code sharing. Each criterion is sub-marked as obligatory or preferably. Scope is migraine subtype CLASSIFICATION (e.g., with-aura vs without-aura), not per-day FORECASTING; the criteria translate selectively. Sample-size guidance is anchored to Serdar et al. 2021 confidence-level-95\% framing rather than Riley/Ensor; cited from the present forecasting paper for criteria 4-6 alignment with explicit scope-mismatch acknowledgement on criterion 1. BMC/JHP convention: article-number serves as locator; pages and number fields both carry the article number 215 (J Headache Pain 25, Article 215).},
}

