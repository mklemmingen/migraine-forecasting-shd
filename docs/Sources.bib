@article{fox2025disability,
  author  = {Fox, Janosch and Gaul, Charly and Ohse, Julia and Peperkorn, Nicolina and Krutzki, Joshua and Shiban, Youssef},
  title   = {Psychological transdiagnostic factors and migraine characteristics as predictors of migraine-related disability},
  journal = {The Journal of Headache and Pain},
  volume  = {26},
  pages   = {167},
  year    = {2025},
  month   = jul,
  doi     = {10.1186/s10194-025-02101-4},
  note    = {JHP-published research article from the PFH Goettingen Department of Psychology group (first author Janosch Fox at affiliation 1: Department of Psychology, PFH Goettingen and affiliation 2: Department of Psychiatry and Psychotherapy, University Medical Center Goettingen; corresponding author Charly Gaul at Medical Faculty University of Duisburg-Essen + Headache Center Frankfurt). Cited at body \S 4.5 (iv) disability-driven future-work direction to anchor two substantive claims: (1) attack frequency alone explains only a moderate fraction of migraine-related disability; (2) psychological transdiagnostic factors contribute substantially beyond migraine symptoms. Both claims supported by direct PDF reading: page 1 abstract reports hierarchical regression on N=158 episodic migraineurs (≥4 migraine days/month) with sociodemographic + migraine symptoms accounting for 49\% of HIT-6 disability variance and adding FAM (Fear Avoidance Model) factors lifting explained variance to 62\% ($\Delta R^2_{adj}=0.13, p<0.001$). Page 2 verbatim quote: "the association between attack frequency and disability ranges from none to only moderate [refs 15-17]. This suggests that higher attack rates do not necessarily correspond to greater disability." Bibliographic details verified against the full 18-page open-access PDF curled from \texttt{thejournalofheadacheandpain.biomedcentral.com/counter/pdf/10.1186/s10194-025-02101-4.pdf}. License: CC BY 4.0. The HIT-6 disability outcome in Fox 2025 matches the HIT-6 baseline characteristic our Table 1 reports for the Park 2016 cohort (62.4 $\pm$ 9.7), providing direct measurement-overlap with our cohort.},
}

@article{hoessly2026brier,
  author  = {Hoessly, Linard},
  title   = {On misconceptions about the {Brier} score in binary prediction models},
  journal = {Global Epidemiology},
  volume  = {11},
  pages   = {100242},
  year    = {2026},
  doi     = {10.1016/j.gloepi.2025.100242},
  note    = {Methodology article (Global Epidemiology, Elsevier; CC BY 4.0; received 19 Aug 2025, accepted 30 Dec 2025, online 7 Jan 2026). Cited at body \S2.5 (Brier-skill methods) and \S3.7 (quality-versus-value interpretation). Verified against the full 8-page open-access PDF (doi:10.1016/j.gloepi.2025.100242). Table 2 recommends: (1) benchmark Brier within the same population against a prevalence baseline; (2) avoid cross-population comparison; (3) combine Brier with calibration, discrimination, and decision-curve measures; (4) report bootstrap CIs on observed Brier. The present study implements all four (per-patient TRAIN-set climatology baseline, within-target comparison, CITL + decision-curve net benefit + within-person C reported alongside, patient-cluster bootstrap B=1000). Misconception 4 (a Brier near the mean-incidence variance $\bar y - \bar y^2$ does not imply a non-informative model) underpins the Murphy quality-versus-value framing at \S3.7. Cites Huang 2020 (our CITL reference), Murphy (our Brier-skill reference), and Assel \& Vickers (the Brier score does not evaluate clinical utility, motivating our decision-curve layer).},
}