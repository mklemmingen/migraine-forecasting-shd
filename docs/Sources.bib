@article{dolanmore2002profile,
  author  = {Dolan, Elizabeth D. and Mor{\'e}, Jorge J.},
  title   = {Benchmarking Optimization Software with Performance Profiles},
  journal = {Mathematical Programming},
  volume  = {91},
  number  = {2},
  pages   = {201--213},
  year    = {2002},
  month   = jan,
  doi     = {10.1007/s101070100263},
  url     = {https://doi.org/10.1007/s101070100263},
  note    = {Canonical reference for the cumulative ratio-to-best benchmark visualisation used in this study. Cited by fig\_f2\_performance\_profile (within-family AUROC profile) and fig\_s1\_wallclock\_train (training wall-clock profile across architecture classes); both adapt the original method: AUROC by replacing higher-is-better with the standard solver-time inversion, and wall-clock by treating per-leaf training duration as the cost metric and (target, feature\_set, split, ratio) tuples as the problem set. The p. 201 anchor is the abstract definitional statement (``We propose performance profiles -- distribution functions for a performance metric -- as a tool for benchmarking and comparing optimization software''). The p. 203 anchor is Section 2 ``Performance Evaluation'' where the formal definitions live: performance ratio $r_{p,s} = t_{p,s} / \min\{t_{p,s} : s \in \mathcal{S}\}$ and performance profile $\rho_s(\tau) = (1/n_p)\,\textrm{size}\{p \in \mathcal{P} : r_{p,s} \le \tau\}$. The p. 204 anchor is the failed-problem convention ($r_{p,s} = r_M$ when solver $s$ does not solve problem $p$, so $\rho_s^* = \lim_{\tau \to r_M^-} \rho_s(\tau)$ is the probability the solver solves a problem); the implementation in fig\_s1 divides by the full $n_p$ denominator rather than the count of valid ratios, so classes with missing cells flatline below 1.0, which is semantically equivalent to the paper's $r_M$ convention. Page references verified against the arXiv:cs/0102001v2 preprint (5 Mar 2004), identical content to the Math. Prog. journal version.}
}

